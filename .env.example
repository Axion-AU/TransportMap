# Copy this file to .env and fill in values before running a production build.
# Never commit .env — it is gitignored.

# Production origin for absolute URLs (og:image, canonical, sitemap).
# Must include protocol and no trailing slash.
VITE_SITE_ORIGIN=https://transportscore.fusionparty.org.au

# Plausible Analytics — domain for the self-hosted instance at analytics.fusionparty.org.au.
# The value is the site domain registered in Plausible (not the Plausible host URL).
# Leave blank to disable analytics entirely (no-op in production, console.debug in dev).
VITE_ANALYTICS_DOMAIN=transportscore.fusionparty.org.au
